Types.VehicleLocation:
  type: struct
  description: Information for vehicle location.
               An IEEE 754‑compliant NaN value shall indicate an invalid or unsupported value.
               When dead reckoning is not enabled, all values shall be set to NaN.
Types.VehicleLocation.Timestamp:
  datatype: string
  type: property
  unit: iso8601
  description: Timestamp for current location, formatted according to ISO 8601 with UTC time zone.
Types.VehicleLocation.Latitude:
  datatype: double
  type: property
  min: -90
  max: 90
  unit: degrees
  description: Current latitude of vehicle in WGS 84 geodetic coordinates.
Types.VehicleLocation.Longitude:
  datatype: double
  type: property
  min: -180
  max: 180
  unit: degrees
  description: Current longitude of vehicle in WGS 84 geodetic coordinates.
Types.VehicleLocation.HorizontalAccuracy:
  datatype: double
  type: property
  unit: m
  description: Accuracy of the latitude and longitude coordinates.
Types.VehicleLocation.Altitude:
  datatype: double
  type: property
  unit: m
  description: Current altitude relative to WGS 84 reference ellipsoid.
Types.VehicleLocation.VerticalAccuracy:
  datatype: double
  type: property
  unit: m
  description: Accuracy of altitude.
Types.VehicleLocation.Heading:
  datatype: double
  type: property
  min: 0
  max: 360
  unit: degrees
  description: Current heading relative to geographic north.
               0 = North, 90 = East, 180 = South, 270 = West.
