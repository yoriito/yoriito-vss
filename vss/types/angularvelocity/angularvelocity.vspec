Types.AngularVelocity:
  type: struct
  description: Spatial rotation. Axis definitions according to ISO 8855.
Types.AngularVelocity.Roll:
  datatype: float
  type: property
  unit: degrees/s
  description: Vehicle rotation rate along X (longitudinal). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
Types.AngularVelocity.Pitch:
  datatype: float
  type: property
  unit: degrees/s
  description: Vehicle rotation rate along Y (lateral). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
Types.AngularVelocity.Yaw:
  datatype: float
  type: property
  unit: degrees/s
  description: Vehicle rotation rate along Z (vertical). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
