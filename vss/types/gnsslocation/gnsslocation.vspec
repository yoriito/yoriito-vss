Types.GNSSLocation:
  type: struct
  description: GNSS positioning information according to ISO 23150=2023.
Types.GNSSLocation.Timestamp:
  datatype: string
  type: property
  unit: iso8601
  description: Timestamp for current location, formatted according to ISO 8601 with UTC time zone.
Types.GNSSLocation.Latitude:
  datatype: double
  type: property
  min: -90
  max: 90
  unit: degrees
  description: Current latitude of vehicle in WGS 84 geodetic coordinates.
Types.GNSSLocation.Longitude:
  datatype: double
  type: property
  min: -180
  max: 180
  unit: degrees
  description: Current longitude of vehicle in WGS 84 geodetic coordinates.
Types.GNSSLocation.HorizontalAccuracy:
  datatype: double
  type: property
  unit: m
  description: Accuracy of the latitude and longitude coordinates.
Types.GNSSLocation.Altitude:
  datatype: double
  type: property
  unit: m
  description: Current altitude relative to WGS 84 reference ellipsoid.
Types.GNSSLocation.VerticalAccuracy:
  datatype: double
  type: property
  unit: m
  description: Accuracy of altitude.
Types.GNSSLocation.FixType:
  datatype: string
  type: property
  allowed: ['NONE',
            'TWO_D',
            'TWO_D_SATELLITE_BASED_AUGMENTATION',
            'TWO_D_GROUND_BASED_AUGMENTATION',
            'TWO_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION',
            'THREE_D',
            'THREE_D_SATELLITE_BASED_AUGMENTATION',
            'THREE_D_GROUND_BASED_AUGMENTATION',
            'THREE_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION']
  description: Fix status.An IEEE 754‑compliant NaN value shall indicate an invalid or unsupported value.
               When this signal has the value NONE, all other signals within the struct shall be set to NaN.
               When the value is TWO_D or TWO_D_XXX, the Altitude and VerticalAccuracy signals shall be set to NaN.
