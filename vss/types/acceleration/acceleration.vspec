Types.Acceleration:
  type: struct
  description: Spatial acceleration. Axis definitions according to ISO 8855.
Types.Acceleration.Longitudinal:
  datatype: float
  type: property
  unit: m/s^2
  description: Vehicle acceleration in X (longitudinal acceleration). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
Types.Acceleration.Lateral:
  datatype: float
  type: property
  unit: m/s^2
  description: Vehicle acceleration in Y (lateral acceleration). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
Types.Acceleration.Vertical:
  datatype: float
  type: property
  unit: m/s^2
  description: Vehicle acceleration in Z (vertical acceleration). An IEEE 754-compliant NaN value shall indicate an invalid or unsupported value, e.g., when the vehicle does not support a particular axis.
