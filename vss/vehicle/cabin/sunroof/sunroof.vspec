Vehicle.Cabin.Sunroof.Slide:
  datatype: uint8
  type: actuator
  unit: percent
  min: 0
  max: 100
  description: Sunroof slide position as a percent. 0 = Fully closed, 100 = Fully opened.
Vehicle.Cabin.Sunroof.Slide_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Sunroof.Slide_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Sunroof.Tilt:
  datatype: uint8
  type: actuator
  unit: percent
  min: 0
  max: 100
  description: Sunroof tilt position as a percent. 0 = Fully closed. 100 = Fully tilted. 
Vehicle.Cabin.Sunroof.Tilt_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Sunroof.Tilt_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Sunroof.Position:
  delete: true
Vehicle.Cabin.Sunroof.Switch:
  delete: true
