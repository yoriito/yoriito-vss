# Seat movement control via the Yoriito Vehicle API is restricted to the safety-defined range specified by the vehicle,
# and may not encompass the full extent of physically operable motion.
# The actual behavior associated with each massage level is subject to the definitions provided by the vehicle system.

Vehicle.Cabin.Seat.Ventilator:
  datatype: uint8
  type: actuator
  min: 0
  max: 100
  unit: percent
  description: Seat ventilation level. 0 = Ventilation deactivated, 100 = Maximum ventilation.
Vehicle.Cabin.Seat.NeckScarf.HeatingCooling:
  datatype: int8
  type: actuator
  min: 0
  max: 100
  unit: percent
  description: Heating or Cooling requsted for the Item.
               -100 = Maximum cooling, 0 = Heating/cooling deactivated, 100 = Maximum heating.
  comment: Since no vehicles equipped with cooling are available,
           the effective implemented range is 0 to 100.
Vehicle.Cabin.Seat.IsWarmerSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsCoolerSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsForwardSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsBackwardSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsUpSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsDownSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsTiltForwardSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsTiltBackwardSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsIncreaseMassageLevelSwitchEngaged:
  delete: true
Vehicle.Cabin.Seat.IsDecreaseMassageLevelSwitchEngaged:
  delete: true
