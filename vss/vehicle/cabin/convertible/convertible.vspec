Vehicle.Cabin.Convertible.IsOpen:
  datatype: boolean
  type: actuator
  description: Is item open or closed? True = Fully or partially open. False = Fully closed.
Vehicle.Cabin.Convertible.Position:
  datatype: uint8
  type: actuator
  min: 0
  max: 100
  unit: percent
  description: Item position. 0 = Fully closed position 100 = Fully Opened position.
Vehicle.Cabin.Convertible.IsOpen_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Convertible.IsOpen_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Convertible.Position_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Convertible.Position_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Cabin.Convertible.Status:
  delete: true
