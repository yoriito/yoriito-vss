# The front windshield wiper system assumed in the Yoriito Vehicle API has two operational endpoints.
# One endpoint represents the position when the vehicle is stopped, and the other represents the turnaround position during wiper operation.
# Wiper systems with structures that do not conform to this assumption must have all Capability signals set to false by the vehicle system.
#  Example:
#   A wiper system that rests in the center when stopped and moves left and right, returning to the center.
#   Typical passenger vehicles have two wiper arms, which operate in synchronization.
#   The Yoriito Vehicle API assumes that the front windshield wipers are controlled as a single system, based on the premise that the wiper arms move in sync.
#   Individual control of each wiper arm is not performed.
# 1. Aggregate Wiping.System.TargetPosition and Wiping.System.ActualPosition
#    into a single signal, Position.
# 2. Change the unit of Wiping.System.Position from degree to percent.
#    Because in the case of degree, the min/max depends on vehicle specific.
Vehicle.Body.Windshield.Wiping.System.TargetPosition:
    delete: true
Vehicle.Body.Windshield.Wiping.System.ActualPosition:
    delete: true
Vehicle.Body.Windshield.Wiping.System.Position:
  datatype: uint8
  unit: percent
  min: 0
  max: 100
  type: actuator
  description: Requested position of main wiper blade.
               0 = Start position, 100 = end position.
               The next RequestedPosition will be executed only after the wiper arm has reached
               the previous RequestedPosition, provided the next position has already been received.
Vehicle.Body.Windshield.Wiping.Mode_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available False = Unavailable.
Vehicle.Body.Windshield.Wiping.Mode_Availability_Sensor:
