Vehicle.Body.Mirrors.Tilt_Availability_Actuator:
  type: sensor
  datatype: boolean
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Body.Mirrors.Tilt_Availability_Sensor:
  type: sensor
  datatype: boolean
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Body.Mirrors.Pan_Availability_Actuator:
