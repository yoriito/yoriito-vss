Vehicle.VersionYoriitoVSS:
  type: branch
  description: Supported Version of YoriitoVSS.
Vehicle.VersionYoriitoVSS.Major:
  datatype: uint32
  type: attribute
  default: 0
  description: Supported Version of YoriitoVSS - Major version.
Vehicle.VersionYoriitoVSS.Minor:
  datatype: uint32
  type: attribute
  default: 2
  description: Supported Version of YoriitoVSS - Minor version.
Vehicle.VersionYoriitoVSS.Patch:
  datatype: uint32
  type: attribute
  default: 0
  description: Supported Version of YoriitoVSS - Patch version.
Vehicle.VersionYoriitoVSS.Label:
  datatype: string
  type: attribute
  default: ''
  description: Label to further describe the version.
