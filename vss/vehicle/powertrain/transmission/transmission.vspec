Vehicle.Powertrain.Transmission.Type:
  allowed: ['UNKNOWN', 'AT', 'MT', 'CVT', 'NONE']
Vehicle.Powertrain.Transmission.TravelledDistance_Availability_Sensor:
  type: sensor
  datatype: boolean
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.CurrentGear_Availability_Sensor:
  type: sensor
  datatype: boolean
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.SelectedGear_Availability_Actuator:
  type: sensor
  datatype: boolean
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.SelectedGear_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.IsParkLockEngaged_Availability_Actuator:
  type: sensor
  datatype: boolean
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.IsParkLockEngaged_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.IsLowRangeEngaged_Availability_Actuator:
  type: sensor
