Vehicle.Powertrain.Transmission.IsLowRangeEngaged_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.Powertrain.Transmission.IsElectricalPowertrainEngaged_Availability_Actuator:
