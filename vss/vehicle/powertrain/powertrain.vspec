Vehicle.Powertrain.TractionBattery:
  type: branch
  instances:
    - Number[1,4]
  description: Number of TractionBarrery.
Vehicle.Powertrain.AccumulatedBrakingEnergy_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.Range_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.TimeRemaining_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.PowerOptimizeLevel_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available False = Unavailable.  
Vehicle.Powertrain.PowerOptimizeLevel_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.IsAutoPowerOptimize_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available False = Unavailable.  
Vehicle.Powertrain.IsAutoPowerOptimize_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
