Vehicle.Powertrain.TractionBattery.AccumulatedChargedThroughput_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.TractionBattery.AccumulatedConsumedThroughput_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.TractionBattery.PowerLoss_Availability_Sensor:
  datatype: boolean
