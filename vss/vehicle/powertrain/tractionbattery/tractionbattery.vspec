Vehicle.Powertrain.TractionBattery.Range:
  instantiate: false
Vehicle.Powertrain.TractionBattery.Range_Availability_Sensor:
  datatype: boolean
  type: sensor
  instantiate: false
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.TractionBattery.TimeRemaining:
  instantiate: false
Vehicle.Powertrain.TractionBattery.TimeRemaining_Availability_Sensor:
  datatype: boolean
  type: sensor
  instantiate: false
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.Powertrain.TractionBattery.Charging:
  instantiate: false
Vehicle.Powertrain.TractionBattery.DCDC:
  instantiate: false
Vehicle.Powertrain.TractionBattery.TotalGrossCapacity:
  datatype: uint16
  type: attribute
  unit: kWh
  instantiate: false
  description: Total Gross capacity of the battery.
Vehicle.Powertrain.TractionBattery.TotalNetCapacity:
  datatype: uint16
  type: sensor
  unit: kWh
  instantiate: false
  description: Total net capacity of the battery considering aging.
Vehicle.Powertrain.TractionBattery.TotalStateOfCharge:
  type: branch
  instantiate: false
  description: Information on the state of charge of the vehicle's total high voltage battery.
Vehicle.Powertrain.TractionBattery.TotalStateOfCharge.Current:
  type: sensor
  unit: percent
  datatype: float
  min: 0
  max: 100.00
  instantiate: false
  description: Physical state of charge of the high voltage battery, relative to net capacity.
               This is not necessarily the state of charge being displayed to the customer.
Vehicle.Powertrain.TractionBattery.TotalStateOfCharge.Displayed:
  type: sensor
  datatype: float
  unit: percent
  min: 0
  max: 100.00
  instantiate: false
  description: State of charge displayed to the customer.
Vehicle.Powertrain.TractionBattery.TotalCurrentVoltage:
  datatype: float
  type: sensor
  unit: V
  instantiate: false
  description: Total Current Voltage of the battery.
Vehicle.Powertrain.TractionBattery.TotalCurrentCurrent:
  datatype: float
  type: sensor
  unit: A
  instantiate: false
  description: Total current current flowing in/out of battery. Positive = Current flowing in to battery, e.g. during charging.
               Negative = Current flowing out of battery, e.g. during driving.
Vehicle.Powertrain.TractionBattery.TotalCurrentPower:
  datatype: float
  type: sensor
  unit: W
  instantiate: false
  description: Total current electrical energy flowing in/out of battery. Positive = Energy flowing in to battery, e.g. during charging.
               Negative = Energy flowing out of battery, e.g. during driving.
