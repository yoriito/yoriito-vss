Vehicle.Powertrain.TractionBattery.Charging.ChargeCurrent.ThreePhaseCurrentMeasurements:
  datatype: Types.ThreePhaseCurrentMeasurements
  type: sensor
  description: Current AC charging current (rms) at inlet. Negative if returning energy to grid.
Vehicle.Powertrain.TractionBattery.Charging.ChargeCurrent.Phase1:
  delete: true
Vehicle.Powertrain.TractionBattery.Charging.ChargeCurrent.Phase2:
  delete: true
Vehicle.Powertrain.TractionBattery.Charging.ChargeCurrent.Phase3:
  delete: true