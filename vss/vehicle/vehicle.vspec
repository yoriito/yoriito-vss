Vehicle.LowVoltageSystemState:
  allowed: [
    'UNKNOWN',   # State of low voltage system not known
    'LOCK',      # Low voltage system off, steering lock or equivalent engaged
    'OFF',       # Low voltage system off, steering lock or equivalent not engaged
    'ACC',       # Vehicle Accessories on/living
    'ON',        # Engine start enabled (e.g. ignition on, diesel pre-heating, electrical drive released)
    'START'      # Engine starter relay closed (not applicable for electrical vehicles)
    ]
Vehicle.TripMeterReading:
  delete: true
Vehicle.TripMeter:
  type: branch
  instances: Number[1,2]
  description: The trip meter is an odometer that can be manually reset by the driver.
  comment: Number1 corresponds to Trip A, Number2 corresponds to Trip B.
Vehicle.TripMeter.Distance:
  datatype: uint32
  type: actuator
  unit: m
  description: Trip meter distance.
Vehicle.CurbWeight:
  default: null
Vehicle.GrossWeight:
  default: null 
Vehicle.MaxTowWeight:
  default: null 
Vehicle.MaxTowBallWeight:
  default: null 
Vehicle.Length:
  default: null 
Vehicle.Height:
  default: null 
Vehicle.WidthExcludingMirrors:
  default: null
