Vehicle.Occupant.HeadPosition:
  datatype: Types.Pose
  type: sensor
  description: The current position of the driver head on vehicle axis according to ISO 23150:2023. The object reference point is head center.
Vehicle.Occupant.HeadPosition.X:
  delete: true
Vehicle.Occupant.HeadPosition.Y:
  delete: true
Vehicle.Occupant.HeadPosition.Z:
  delete: true
Vehicle.Occupant.HeadPosition.Yaw:
  delete: true
Vehicle.Occupant.HeadPosition.Pitch:
  delete: true
Vehicle.Occupant.HeadPosition.Roll:
  delete: true
