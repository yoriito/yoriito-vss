Vehicle.Occupant.MidEyeGaze:
  datatype: Types.PointingDirection
  type: sensor
  description: Direction from mid eye position to object driver is looking at. The object reference point is driver mid eye position. The target point is the point of gaze.
Vehicle.Occupant.MidEyeGaze.Azimuth:
  delete: true
Vehicle.Occupant.MidEyeGaze.Elevation:
  delete: true