Vehicle.ADAS.ObstacleDetection.IsEnabled_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available False = Unavailable.
Vehicle.ADAS.ObstacleDetection.IsEnabled_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.ADAS.ObstacleDetection.IsWarning_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.ADAS.ObstacleDetection.DegradationStatus:
  datatype: string
  type: sensor
  allowed: ["NO_DEGRADATION", "CAMERA_OBSTRUCTION_DETECTED", "ENV_CONDITION_BAD", "OTHER"]
  description:
    Indicates the current functional limitation or performance degradation status of ObstacleDetection.
    This status may include non-fault conditions such as temporary limitations, reduced performance, or fallback modes.
Vehicle.ADAS.ObstacleDetection.DegradationStatus_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
Vehicle.ADAS.ObstacleDetection.IsError:
  delete: true
