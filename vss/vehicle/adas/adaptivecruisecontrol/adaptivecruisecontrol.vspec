Vehicle.ADAS.AdaptiveCruiseControl:
  type: branch
  description: Signals from Adaptive Cruise Control system.
Vehicle.ADAS.AdaptiveCruiseControl.IsEnabled:
  datatype: boolean
  type: actuator
  description: Indicates if Adaptive cruise control system is enabled (e.g. ready to receive configurations and settings)
               True = Enabled. False = Disabled.
Vehicle.ADAS.AdaptiveCruiseControl.IsEnabled_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.IsEnabled_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.IsActive:
  datatype: boolean
  type: actuator
  description: Indicates if Adaptive cruise control system is active (i.e. actively controls speed).
               True = Active. False = Inactive.
Vehicle.ADAS.AdaptiveCruiseControl.IsActive_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.IsActive_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.SpeedSet:
  datatype: float
  type: actuator
  unit: km/h
  description: Set Adaptive cruise control speed in kilometers per hour.
Vehicle.ADAS.AdaptiveCruiseControl.SpeedSet_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.SpeedSet_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.DistanceSet:
  datatype: string
  type: actuator
  allowed: ["DIST_1","DIST_2","DIST_3","DIST_4","DIST_5"]
  description: Set the following distance for adaptive cruise control. DIST_1 indicates the shortest following distance.
Vehicle.ADAS.AdaptiveCruiseControl.DistanceSet_Availability_Actuator:
  datatype: boolean
  type: sensor
  description: Availability of actuating the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.DistanceSet_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.ADAS.AdaptiveCruiseControl.DegradationStatus:
  datatype: string
  type: sensor
  allowed: ["NO_DEGRADATION","CONTAMINATION","OTHER"]
  description: Indicates the current functional limitation or performance degradation status of Adaptive Cruise Control.
               This status may include non-fault conditions such as temporary limitations, reduced performance, or fallback modes.
Vehicle.ADAS.AdaptiveCruiseControl.DegradationStatus_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available False = Unavailable.
