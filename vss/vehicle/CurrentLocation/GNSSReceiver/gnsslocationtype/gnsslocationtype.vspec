Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Timestamp:
  datatype: string
  type: sensor
  unit: iso8601
  description: Timestamp from GNSS system for current location, formatted according to ISO 8601 with UTC time zone.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Timestamp_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Latitude:
  datatype: double
  type: sensor
  min: -90
  max: 90
  unit: degrees
  description: Current latitude of vehicle in WGS 84 geodetic coordinates, as measured at the position of GNSS receiver antenna.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Latitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Longitude:
  datatype: double
  type: sensor
  min: -180
  max: 180
  unit: degrees
  description: Current longitude of vehicle in WGS 84 geodetic coordinates, as measured at the position of GNSS receiver antenna.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Longitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.HorizontalAccuracy:
  datatype: double
  type: sensor
  unit: m
  description: Accuracy of the latitude and longitude coordinates.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.HorizontalAccuracy_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Altitude:
  datatype: double
  type: sensor
  unit: m
  description: Current altitude relative to WGS 84 reference ellipsoid, as measured at the position of GNSS receiver antenna.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.Altitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.VerticalAccuracy:
  datatype: double
  type: sensor
  unit: m
  description: Accuracy of altitude.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.VerticalAccuracy_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.FixType:
  datatype: string
  type: sensor
  allowed: ['NONE',
            'TWO_D',
            'TWO_D_SATELLITE_BASED_AUGMENTATION',
            'TWO_D_GROUND_BASED_AUGMENTATION',
            'TWO_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION',
            'THREE_D',
            'THREE_D_SATELLITE_BASED_AUGMENTATION',
            'THREE_D_GROUND_BASED_AUGMENTATION',
            'THREE_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION']
  description: Fix status of GNSS receiver.

Vehicle.CurrentLocation.GNSSReceiver.GNSSLocationType.FixType_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
  