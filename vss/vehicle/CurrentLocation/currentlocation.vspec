Vehicle.CurrentLocation.VehicleLocationType:
  type: branch
  description: Information for current vehicle location from vehicle coordinate system.

Vehicle.CurrentLocation.ReferencePosition:
  type: branch
  description: Reference position of vehicle location. Axis definitions according to ISO 8855. Origin at center of (first) rear axle.

Vehicle.CurrentLocation.Timestamp:
  delete: true

Vehicle.CurrentLocation.Latitude:
  delete: true

Vehicle.CurrentLocation.Longitude:
  delete: true

Vehicle.CurrentLocation.Heading:
  delete: true

Vehicle.CurrentLocation.HorizontalAccuracy:
  delete: true

Vehicle.CurrentLocation.Altitude:
  delete: true

Vehicle.CurrentLocation.VerticalAccuracy:
  delete: true
