Vehicle.CurrentLocation.VehicleLocationType.Timestamp:
  datatype: string
  type: sensor
  unit: iso8601
  description: Timestamp for current vehicle location, formatted according to ISO 8601 with UTC time zone.
Vehicle.CurrentLocation.VehicleLocationType.Timestamp_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.Latitude:
  datatype: double
  type: sensor
  min: -90
  max: 90
  unit: degrees
  description: Current latitude of vehicle in WGS 84 geodetic coordinates.
Vehicle.CurrentLocation.VehicleLocationType.Latitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.Longitude:
  datatype: double
  type: sensor
  min: -180
  max: 180
  unit: degrees
  description: Current longitude of vehicle in WGS 84 geodetic coordinates.
Vehicle.CurrentLocation.VehicleLocationType.Longitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.Heading:
  datatype: double
  type: sensor
  min: 0
  max: 360
  unit: degrees
  description: Current heading relative to geographic north.
               0 = North, 90 = East, 180 = South, 270 = West.
Vehicle.CurrentLocation.VehicleLocationType.Heading_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.HorizontalAccuracy:
  datatype: double
  type: sensor
  unit: m
  description: Accuracy of the latitude and longitude coordinates.
Vehicle.CurrentLocation.VehicleLocationType.HorizontalAccuracy_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.Altitude:
  datatype: double
  type: sensor
  unit: m
  description: Current altitude relative to WGS 84 reference ellipsoid.
Vehicle.CurrentLocation.VehicleLocationType.Altitude_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.VerticalAccuracy:
  datatype: double
  type: sensor
  unit: m
  description: Accuracy of altitude.
Vehicle.CurrentLocation.VehicleLocationType.VerticalAccuracy_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
Vehicle.CurrentLocation.VehicleLocationType.DeadReckoningIsActive:
  datatype: boolean
  type: sensor
  description: DeadReckoning active or inactive. True = Active. False = Inactive.
Vehicle.CurrentLocation.VehicleLocationType.DeadReckoningIsActive_Availability_Sensor:
  datatype: boolean
  type: sensor
  description: Availability of sensing the signal. True = Available. False = Unavailable.
